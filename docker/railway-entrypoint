#!/usr/bin/env bash
set -euo pipefail

readonly runtime_uid=1000
readonly runtime_gid=1000
readonly workspace_root=/data/workspaces
readonly agent_dir=/data/pi-agent
readonly config_file=/data/config/pi-web/config.json
readonly managed_profile_dir=/opt/pi-web-managed-profile
readonly ownership_marker=/data/.pi-web-runtime-owner
readonly expected_ownership="v1:$runtime_uid:$runtime_gid"

volume_ownership_is_current=false
if [[ -f "$ownership_marker" ]] \
  && [[ "$(cat "$ownership_marker")" == "$expected_ownership" ]]; then
  volume_ownership_is_current=true
else
  printf '%s\n' 'Preparing persistent volume ownership (one-time scan)...'
fi

mkdir -p \
  /data/home/.ssh \
  /data/home/.pi \
  /data/config/pi-web \
  /data/pi-web \
  "$agent_dir/bin" \
  /var/tmp/cargo-target \
  "$agent_dir" \
  "$workspace_root"
if [[ "$volume_ownership_is_current" == false ]]; then
  chown -R "$runtime_uid:$runtime_gid" /data
fi
chmod 0700 /data/home/.ssh "$agent_dir"

# Rustup is intentionally kept on the persistent volume instead of inflating
# every application image with a second toolchain. Make an installed toolchain
# visible to non-interactive agent shells, whose PATH includes agent_dir/bin,
# and recreate the disposable Cargo target root lost with each container.
for rust_command in cargo rustc rustup cargo-clippy cargo-fmt wasm-bindgen cargo-binstall; do
  rust_command_source="/data/home/.cargo/bin/$rust_command"
  if [[ -x "$rust_command_source" ]]; then
    ln -sfnT "$rust_command_source" "$agent_dir/bin/$rust_command"
  fi
done
chown "$runtime_uid:$runtime_gid" /var/tmp/cargo-target "$agent_dir/bin"

readonly default_agent_link=/data/home/.pi/agent
if [[ -L "$default_agent_link" ]]; then
  if [[ "$(readlink "$default_agent_link")" != "$agent_dir" ]]; then
    printf 'Unexpected Pi agent profile symlink target: %s\n' "$(readlink "$default_agent_link")" >&2
    exit 71
  fi
elif [[ -e "$default_agent_link" ]]; then
  printf 'Default Pi agent profile path exists and is not a symlink: %s\n' "$default_agent_link" >&2
  exit 72
else
  ln -s "$agent_dir" "$default_agent_link"
fi

# This small, non-secret profile is owned by the deployment. Runtime-owned Pi
# state (auth, sessions, trust, package caches, and extension state) remains on
# the persistent volume and is deliberately not mirrored or removed here.
install_managed_profile_file() {
  local source_file="$1"
  local target_file="$2"
  local temporary_file="$target_file.tmp-$$"
  install -o "$runtime_uid" -g "$runtime_gid" -m 0600 "$source_file" "$temporary_file"
  mv -f "$temporary_file" "$target_file"
}

install_managed_profile_file "$managed_profile_dir/AGENTS.md" "$agent_dir/AGENTS.md"
for managed_subdirectory in agents prompts; do
  managed_target_dir="$agent_dir/$managed_subdirectory"
  install -d -o "$runtime_uid" -g "$runtime_gid" -m 0700 "$managed_target_dir"
  while IFS= read -r -d '' managed_source_file; do
    install_managed_profile_file \
      "$managed_source_file" \
      "$managed_target_dir/$(basename "$managed_source_file")"
  done < <(find "$managed_profile_dir/$managed_subdirectory" -maxdepth 1 -type f -print0)
done

# Retire the exact deployment-owned predecessor after the worker routing model
# moved from worker/worker-strong to fresh/fork plus a per-run model override.
rm -f -- "$agent_dir/agents/worker-strong.md"

if [[ -n "${PI_WEB_GIT_USER_NAME:-}" ]]; then
  git config --global user.name "$PI_WEB_GIT_USER_NAME"
fi

if [[ -n "${PI_WEB_GIT_USER_EMAIL:-}" ]]; then
  git config --global user.email "$PI_WEB_GIT_USER_EMAIL"
fi

if [[ ! -f "$config_file" ]]; then
  cat >"$config_file" <<'JSON'
{
  "host": "0.0.0.0",
  "pathAccess": {
    "allowedPaths": ["/data/workspaces"]
  },
  "spawnSessions": true,
  "subsessions": false
}
JSON
  chmod 0600 "$config_file"
fi

if [[ -n "${TOGETHER_API_KEY:-}" ]]; then
  node <<'NODE'
const fs = require("node:fs");
const path = require("node:path");

const agentDir = "/data/pi-agent";
const model = process.env.PI_WEB_TOGETHER_MODEL || "zai-org/GLM-5.3";
const workerModel = "together/zai-org/GLM-5.3-Flash";
const workerDescription = "DEFAULT fresh-context writer on GLM-5.3-Flash for routine, localized, reversible work with clear acceptance criteria. Use worker-fork when the parent's verified context should carry the work. Pass model together/zai-org/GLM-5.3 per-run for architecture, security/auth, concurrency, persistence/migrations, cross-subsystem changes, difficult debugging, or after Flash stalls or fails verification.";
const scoutDescription = "Low-cost read-oriented scout on GLM-5.3-Flash. Use for bounded reconnaissance; reviewer and oracle inherit the full GLM-5.3 subagent default.";

function readObject(file) {
  if (!fs.existsSync(file)) return {};
  const value = JSON.parse(fs.readFileSync(file, "utf8"));
  if (value === null || Array.isArray(value) || typeof value !== "object") {
    throw new Error(`${file} must contain a JSON object`);
  }
  return value;
}

function writePrivate(file, value) {
  const temporary = `${file}.tmp-${process.pid}`;
  fs.writeFileSync(temporary, `${JSON.stringify(value, null, 2)}\n`, { mode: 0o600 });
  fs.renameSync(temporary, file);
  fs.chmodSync(file, 0o600);
}

const authFile = path.join(agentDir, "auth.json");
const auth = readObject(authFile);
auth.together = { type: "api_key", key: process.env.TOGETHER_API_KEY };
writePrivate(authFile, auth);

const settingsFile = path.join(agentDir, "settings.json");
const settings = readObject(settingsFile);
settings.defaultProvider = "together";
settings.defaultModel = model;
const selectedModel = `together/${model}`;
const enabled = Array.isArray(settings.enabledModels)
  ? settings.enabledModels.filter((entry) => entry !== "together/*")
  : [];
if (!enabled.includes(selectedModel)) enabled.push(selectedModel);
if (!enabled.includes(workerModel)) enabled.push(workerModel);
settings.enabledModels = enabled;
const subagents = settings.subagents && !Array.isArray(settings.subagents) && typeof settings.subagents === "object"
  ? settings.subagents
  : {};
subagents.defaultModel = selectedModel;
const agentOverrides = subagents.agentOverrides && !Array.isArray(subagents.agentOverrides) && typeof subagents.agentOverrides === "object"
  ? subagents.agentOverrides
  : {};
const scoutOverride = agentOverrides.scout && !Array.isArray(agentOverrides.scout) && typeof agentOverrides.scout === "object"
  ? agentOverrides.scout
  : {};
const workerOverride = agentOverrides.worker && !Array.isArray(agentOverrides.worker) && typeof agentOverrides.worker === "object"
  ? agentOverrides.worker
  : {};
agentOverrides.scout = { ...scoutOverride, model: workerModel, description: scoutDescription };
agentOverrides.worker = { ...workerOverride, model: workerModel, description: workerDescription };
subagents.agentOverrides = agentOverrides;
settings.subagents = subagents;
writePrivate(settingsFile, settings);
NODE
fi

node /opt/pi-web/scripts/merge-managed-pi-profile.mjs \
  "$managed_profile_dir/packages.json" \
  "$agent_dir/settings.json"

if [[ -n "${PI_WEB_GIT_DEPLOY_KEY_B64:-}" ]]; then
  readonly key_file=/data/home/.ssh/pi-web-deploy-key
  printf '%s' "$PI_WEB_GIT_DEPLOY_KEY_B64" | base64 --decode >"$key_file"
  chmod 0600 "$key_file"

  curl --fail --silent --show-error https://api.github.com/meta \
    | jq -r '.ssh_keys[] | "github.com " + .' \
    >/data/home/.ssh/known_hosts
  chmod 0600 /data/home/.ssh/known_hosts

  cat >/data/home/.ssh/config <<EOF
Host github.com
  HostName github.com
  User git
  IdentityFile $key_file
  IdentitiesOnly yes
  UserKnownHostsFile /data/home/.ssh/known_hosts
  StrictHostKeyChecking yes
EOF
  chmod 0600 /data/home/.ssh/config
fi

workspace_was_cloned=false
if [[ -n "${PI_WEB_GIT_REPOSITORY:-}" ]]; then
  readonly workspace_name="${PI_WEB_WORKSPACE_NAME:-$(basename "${PI_WEB_GIT_REPOSITORY%.git}")}"
  readonly workspace_path="$workspace_root/$workspace_name"
  if ! git config --global --get-all safe.directory | grep --fixed-strings --line-regexp --quiet -- "$workspace_path"; then
    git config --global --add safe.directory "$workspace_path"
  fi
  if [[ -d "$workspace_path/.git" ]]; then
    existing_remote="$(git -C "$workspace_path" remote get-url origin)"
    if [[ "$existing_remote" != "$PI_WEB_GIT_REPOSITORY" ]]; then
      printf 'Existing workspace has unexpected origin: %s\n' "$existing_remote" >&2
      exit 68
    fi
  else
    if [[ -e "$workspace_path" ]]; then
      printf 'Workspace path exists but is not a Git checkout: %s\n' "$workspace_path" >&2
      exit 69
    fi
    if [[ -z "${PI_WEB_GIT_DEPLOY_KEY_B64:-}" ]]; then
      printf '%s\n' 'PI_WEB_GIT_DEPLOY_KEY_B64 is required to clone PI_WEB_GIT_REPOSITORY' >&2
      exit 70
    fi
    GIT_SSH_COMMAND="ssh -F /data/home/.ssh/config" \
      git clone -- "$PI_WEB_GIT_REPOSITORY" "$workspace_path"
    workspace_was_cloned=true
  fi
fi

# Startup runs as root so it can initialize a fresh Railway volume, but only a
# small set of managed files is rewritten on an ordinary wake. Keep those files
# accessible to the runtime user without walking every persisted workspace,
# dependency cache, and session. A newly cloned workspace is the one exception.
runtime_owned_paths=(
  /data
  /data/home
  /data/home/.ssh
  /data/home/.pi
  /data/config
  /data/config/pi-web
  /data/pi-web
  "$agent_dir"
  "$agent_dir/bin"
  "$workspace_root"
  "$config_file"
  "$agent_dir/AGENTS.md"
  "$agent_dir/auth.json"
  "$agent_dir/settings.json"
  /data/home/.gitconfig
  /data/home/.ssh/pi-web-deploy-key
  /data/home/.ssh/known_hosts
  /data/home/.ssh/config
)
existing_runtime_owned_paths=()
for path in "${runtime_owned_paths[@]}"; do
  if [[ -e "$path" || -L "$path" ]]; then
    existing_runtime_owned_paths+=("$path")
  fi
done
chown "$runtime_uid:$runtime_gid" "${existing_runtime_owned_paths[@]}"
if [[ "$workspace_was_cloned" == true ]]; then
  chown -R "$runtime_uid:$runtime_gid" "$workspace_path"
fi
chmod 0700 /data/home/.ssh "$agent_dir"

# Write this only after provisioning succeeds. If the first startup is
# interrupted, the next attempt safely repeats the migration scan.
ownership_marker_tmp="$ownership_marker.tmp-$$"
printf '%s\n' "$expected_ownership" >"$ownership_marker_tmp"
chmod 0600 "$ownership_marker_tmp"
mv -f "$ownership_marker_tmp" "$ownership_marker"

# Provisioning inputs have been materialized into private files. Do not pass
# their transport forms into the session daemon or agent child processes.
unset TOGETHER_API_KEY PI_WEB_GIT_DEPLOY_KEY_B64

exec setpriv \
  --reuid="$runtime_uid" \
  --regid="$runtime_gid" \
  --init-groups \
  /usr/local/bin/pi-web-railway-supervisor
